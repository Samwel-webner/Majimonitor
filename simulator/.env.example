# Copy to .env

# Base URL of the running MajiMonitor backend
API_BASE_URL=http://localhost:5000/api

# How often to generate a new round of readings, in milliseconds
# 30000 = every 30 seconds. Use something short (e.g. 5000) while demoing.
INTERVAL_MS=30000

# Probability (0-1) that any given site/parameter drifts into an
# out-of-range "event" on a given tick, to keep alerts interesting
EVENT_PROBABILITY=0.08

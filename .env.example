# Copy this file to .env and fill in your real values. Never commit .env itself.

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=majimonitor

# Server
PORT=5000

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h

# Email alerts (optional - fill in if using Nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=alerts@majimonitor.thiwasco.co.ke
ALERT_EMAIL_TO=
